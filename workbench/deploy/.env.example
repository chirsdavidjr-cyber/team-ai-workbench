# ===== 湖北 AI 工作台 环境配置（复制为 workbench/.env 后修改）=====

# JWT 签名密钥（务必改成随机长串）
SECRET_KEY=change-me-to-a-long-random-string

# 初始管理员（仅首次启动 seed 用）
ADMIN_EMAIL=admin@team.local
ADMIN_PASSWORD=admin123456

# 是否开放自助注册（团队规模固定时建议 false，账号管理员统一开）
ALLOW_REGISTER=true

# 种子模型供应商（智谱 GLM；首次启动写入，之后可在页面管理）
SEED_PROVIDER_NAME=智谱 GLM
SEED_PROVIDER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
SEED_PROVIDER_API_KEY=743cd735cc0942e897c8a12544d59735.sL7gpAhHYgBmqu8g
SEED_PROVIDER_MODELS=[{"id":"glm-5.3","label":"GLM-5.3"},{"id":"glm-5.3-flash","label":"GLM-5.3-Flash"},{"id":"glm-4.6","label":"GLM-4.6"}]

# 知识库向量化（智谱 embedding-3，与上面同 Key 即可）
KB_EMBEDDING_API_KEY=743cd735cc0942e897c8a12544d59735.sL7gpAhHYgBmqu8g

# 批量任务默认模型（可留空，自动回退启用的团队供应商）
DATA_LLM_PROVIDER_ID=1
DATA_LLM_MODEL=glm-5.3

# 局域网他机访问时无需配置 CORS（前端已同源反代）；如直连 8000 才需要：
# CORS_ORIGINS=http://192.168.1.10:3200,http://192.168.1.11:3200
